{
  "name": "pulsegraph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" next dev --port ${PORT:-3000} --hostname ${FIGMA_DEV_SERVER_HOST:-0.0.0.0}",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload build",
    "start": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" next start",
    "format": "oxfmt",
    "generate:importmap": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload generate:importmap",
    "generate:types": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload generate:types",
    "payload": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-deprecation\" payload",
    "lint": "oxlint -D correctness src/components src/data src/app/api/analyze src/lib/server src/lib/store.ts && tsc --noEmit",
    "test": "node --test tests/demo.test.mjs",
    "test:api": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "@payloadcms/figma": "1.0.0-beta.4",
    "@payloadcms/next": "4.0.0-beta.11",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.11",
    "@payloadcms/plugin-mcp": "4.0.0-beta.11",
    "@payloadcms/richtext-lexical": "4.0.0-beta.11",
    "@payloadcms/translations": "4.0.0-beta.11",
    "@payloadcms/ui": "4.0.0-beta.11",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "d3-force": "^3.0.1",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "graphql": "^16.8.1",
    "gsap": "^3.15.1",
    "html-react-parser": "^5.2.10",
    "lenis": "^1.3.28",
    "lucide-react": "^1.79.0",
    "monaco-editor": "0.55.1",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "payload": "4.0.0-beta.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.11.1",
    "sharp": "^0.35.4",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.95.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
